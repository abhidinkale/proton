PORT=3002

# ------------------------------------------------------------------------------
# Durable database (± REQUIRED for the clinic loop)
# ------------------------------------------------------------------------------
# Unset -> every workflow/patient/clinic store runs in memory. Fine for the
# deterministic test suites; NOT fine for the patient app or the Care Loop,
# which return 503 rather than inventing state. The demo seed refuses to run
# without this value.
# DATABASE_URL=postgres://localhost:5432/proton_demo
PROTON_AI_MODE=demo
PROTON_AI_PROVIDER=demo

# DeepSeek API (Beta Provider)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Gemini API (Alternative Provider)
GEMINI_API_KEY=
PROTON_AI_MODEL=gemini-3.8-flash

# Grok / xAI API (Alternative Provider)
XAI_API_KEY=
XAI_MODEL=grok-2-vision-1212

# MedGemma 1.5 4B (Local AI Provider - MLX-VLM Apple Silicon)
# PROTON_AI_PROVIDER=medgemma
# PROTON_AI_MODE=local
MEDGEMMA_BASE_URL=http://localhost:8000/v1
MEDGEMMA_MODEL=mlx-community/medgemma-1.5-4b-it-4bit

# ------------------------------------------------------------------------------
# Security posture (REQUIRED in production — the API exits if these are missing)
# ------------------------------------------------------------------------------
# 32+ random characters. Generate with: openssl rand -base64 48
PROTON_AUTH_SECRET=
# 16+ random characters. Shared secret for internal tool invocation only.
INTERNAL_AGENT_SECRET=

# Synthetic mode resolves unauthenticated requests to a seeded development
# physician. It is automatically off when NODE_ENV=production, and this flag
# lets you switch it off explicitly everywhere else.
PROTON_SYNTHETIC_MODE=false

# Refuse the hardcoded evaluation accounts (dr.lin@proton.health, etc.).
PROTON_ALLOW_DEMO_ACCOUNTS=false

# Require a MFA/TOTP challenge at /api/auth/login.
PROTON_REQUIRE_MFA=false

# ------------------------------------------------------------------------------
# Durable clinical workflow (PostgreSQL + pg-boss)
# ------------------------------------------------------------------------------
# System of record for the encounter state machine, outbox and audit chain.
# Leave unset for SQLite/fixture-only development; the /api/workflow routes then
# return 503 WORKFLOW_PERSISTENCE_DISABLED. REQUIRED in production.
DATABASE_URL=postgres://localhost:5432/proton_ops
# postgres (default when DATABASE_URL is set) | disabled
WORKFLOW_PERSISTENCE=postgres
# Set to "off" to run the API without the recurring outbox safety-net job
# (the worker still drains on demand via POST /api/workflow/outbox/dispatch).
WORKFLOW_SCHEDULER=on

# ------------------------------------------------------------------------------
# Patient one-time-code delivery (± REQUIRED for real patients)
# ------------------------------------------------------------------------------
# simulated (default) — nothing is sent. Synthetic builds return a devCode so a
#   demo can log in. A real patient cannot: do not invite one while this is the
#   setting. GET /health/email reports which mode is live.
# email — hand the code to a provider. The response stops returning devCode
#   (even in synthetic mode), and a failed send is a 502 instead of a fake
#   success. Requires all three of the values below.
OTP_DELIVERY=simulated
# brevo | resend. Brevo's free tier (300/day) does not require a verified
# domain, only a verified sender address; Resend does, so it needs the domain.
EMAIL_PROVIDER=
# Server-side only. Never ship this in the APK and never log it.
EMAIL_API_KEY=
# The sender patients will see. Must be verified with the provider.
EMAIL_FROM=
# Optional display name in the From header.
# EMAIL_FROM_NAME=Proton Care
# Optional, milliseconds. Defaults to 8000.
# EMAIL_TIMEOUT_MS=8000
