<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network policy.

  SyncUrlPolicy already refuses plain http:// unless the host is loopback or a
  private RFC1918 address, but Android's platform default blocks cleartext for
  every host on targetSdk 28+, so the check would never be reached: the request
  would die in the socket layer with a generic connection error.

  Android's network-security-config cannot express an address range, and a
  developer's laptop moves between networks, so this file permits cleartext for
  the whole debug build and leaves the address decision to SyncUrlPolicy, which
  is the stricter of the two.

  Release builds do not include this file. A production APK can still only
  speak TLS, and the policy refuses http:// there regardless.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="true" />
</network-security-config>
