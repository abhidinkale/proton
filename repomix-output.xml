              {/* AUG SYMPTOMS MODAL */}
              {activeModal === 'aug-symptoms' && (
                <>
                  <h3 className="text-xl font-bold text-[#141a16]">Symptom Inventory &amp; Physical Exam</h3>
                  <p className="text-xs text-[#718076]">Documented August 2022</p>

                  <div className="space-y-2 text-xs">
                    <div className="bg-white p-3 rounded-2xl border border-black/5">
                      <div className="font-bold text-[#161c18]">Severe Temporal Cephalalgia</div>
                      <p className="text-[#718076] mt-0.5">Pulsatile bitemporal headache, exacerbated by bending forward. Responsive to blood pressure lowering.</p>
                    </div>

                    <div className="bg-white p-3 rounded-2xl border border-black/5">
                      <div className="font-bold text-[#161c18]">Exertional Tremor</div>
