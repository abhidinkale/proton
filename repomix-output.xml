<file path="apps/web/src/components/ui/ClinicalAlert.tsx">
import type { ReactNode } from 'react';
import { AlertTriangle, AlertOctagon, CheckCircle2, Info } from 'lucide-react';

export type AlertSeverity = 'blocked' | 'warning' | 'info' | 'success';

interface ClinicalAlertProps {
  severity: AlertSeverity;
  title: string;
  description?: string;
  action?: ReactNode;
  className?: string;
}

export default function ClinicalAlert({
  severity,
  title,
  description,
  action,
  className = ''
}: ClinicalAlertProps) {
  let config: {
    bg: string;
    border: string;
    text: string;
    titleColor: string;
    icon: ReactNode;
  };

  switch (severity) {
    case 'blocked':
      config = {
        bg: 'bg-rose-50/80',
        border: 'border-rose-200',
        text: 'text-rose-800',
        titleColor: 'text-rose-950 font-bold',
        icon: <AlertOctagon size={18} className="text-rose-600 shrink-0 mt-0.5" />
      };
      break;
    case 'warning':
      config = {
        bg: 'bg-amber-50/80',
        border: 'border-amber-200',
        text: 'text-amber-800',
        titleColor: 'text-amber-950 font-bold',
        icon: <AlertTriangle size={18} className="text-amber-600 shrink-0 mt-0.5" />
      };
      break;
    case 'success':
      config = {
        bg: 'bg-emerald-50/80',
        border: 'border-emerald-200',
        text: 'text-emerald-800',
        titleColor: 'text-emerald-950 font-bold',
        icon: <CheckCircle2 size={18} className="text-emerald-600 shrink-0 mt-0.5" />
      };
      break;
    case 'info':
    default:
      config = {
        bg: 'bg-sky-50/80',
        border: 'border-sky-200',
        text: 'text-sky-800',
        titleColor: 'text-sky-950 font-bold',
        icon: <Info size={18} className="text-sky-600 shrink-0 mt-0.5" />
      };
      break;
  }

  return (
    <div
      className={`rounded-xl border p-4 flex items-start justify-between gap-3 ${config.bg} ${config.border} ${className}`}
    >
      <div className="flex items-start gap-3 min-w-0">
        {config.icon}
        <div className="min-w-0">
          <h4 className={`text-sm ${config.titleColor}`}>{title}</h4>
          {description && (
            <p className={`text-xs mt-0.5 leading-relaxed ${config.text}`}>
              {description}
            </p>
          )}
        </div>
      </div>
      {action && <div className="shrink-0">{action}</div>}
    </div>
  );
}
</file>

<file path="apps/web/src/components/ui/ConfidenceBadge.tsx">
interface ConfidenceBadgeProps {
  confidence: number | string; // e.g. 0.92 or "92%"
  labelPrefix?: string;
  size?: 'xs' | 'sm';
  className?: string;
}

export default function ConfidenceBadge({
  confidence,
  labelPrefix = 'AI extraction',
  size = 'sm',
  className = ''
}: ConfidenceBadgeProps) {
  let numeric = 0;
  let displayStr = '';

  if (typeof confidence === 'number') {
    numeric = confidence <= 1 ? Math.round(confidence * 100) : Math.round(confidence);
    displayStr = `${numeric}%`;
  } else {
    displayStr = confidence.trim();
    const parsed = parseInt(displayStr.replace(/\D/g, ''), 10);
    numeric = isNaN(parsed) ? 85 : parsed;
    if (!displayStr.includes('%')) displayStr += '%';
  }

  let style = 'bg-blue-50 text-blue-800 border-blue-200';
  let dotColor = 'bg-blue-500';

  if (numeric >= 90) {
    style = 'bg-emerald-50 text-emerald-800 border-emerald-200';
    dotColor = 'bg-emerald-500';
  } else if (numeric >= 75) {
    style = 'bg-sky-50 text-sky-800 border-sky-200';
    dotColor = 'bg-sky-500';
  } else {
    style = 'bg-amber-50 text-amber-900 border-amber-200';
    dotColor = 'bg-amber-500';
  }

  const sizeClass = size === 'xs' ? 'px-1.5 py-0.2 text-[9px]' : 'px-2 py-0.5 text-[10px]';

  return (
    <span
      title={`Model extraction confidence score: ${displayStr}`}
      className={`inline-flex items-center gap-1.5 font-bold uppercase tracking-wider rounded-md border ${style} ${sizeClass} ${className}`}
    >
      <span className={`h-1.5 w-1.5 rounded-full ${dotColor}`} />
      <span>{labelPrefix} {displayStr}</span>
    </span>
  );
}
</file>

<file path="apps/web/src/components/ui/StatusBadge.tsx">
export type StatusVariant = 
  | 'active'
  | 'draft'
  | 'completed'
  | 'warning'
  | 'critical'
  | 'info'
  | 'neutral';

interface StatusBadgeProps {
  status: string;
  variant?: StatusVariant;
  size?: 'xs' | 'sm' | 'md';
  pulse?: boolean;
  className?: string;
}

export default function StatusBadge({
  status,
  variant = 'neutral',
  size = 'sm',
  pulse = false,
  className = ''
}: StatusBadgeProps) {
  let style = 'bg-slate-100 text-slate-700 border-slate-200';
  let dotColor = 'bg-slate-400';

  switch (variant) {
    case 'active':
      style = 'bg-emerald-50 text-emerald-800 border-emerald-200';
      dotColor = 'bg-emerald-500';
      break;
    case 'completed':
      style = 'bg-teal-50 text-teal-800 border-teal-200';
      dotColor = 'bg-teal-500';
      break;
    case 'draft':
      style = 'bg-amber-50 text-amber-900 border-amber-200';
      dotColor = 'bg-amber-500';
      break;
    case 'warning':
      style = 'bg-amber-100 text-amber-900 border-amber-300';
      dotColor = 'bg-amber-600';
      break;
    case 'critical':
      style = 'bg-rose-50 text-rose-800 border-rose-200';
      dotColor = 'bg-rose-600';
      break;
    case 'info':
      style = 'bg-sky-50 text-sky-800 border-sky-200';
      dotColor = 'bg-sky-500';
      break;
    case 'neutral':
    default:
      style = 'bg-slate-100 text-slate-700 border-slate-200';
      dotColor = 'bg-slate-400';
      break;
  }

  const sizeClass = size === 'xs'
    ? 'px-1.5 py-0.2 text-[9px] gap-1'
    : size === 'md'
    ? 'px-2.5 py-1 text-xs gap-1.5'
    : 'px-2 py-0.5 text-[10px] gap-1.2';

  return (
    <span
      className={`inline-flex items-center font-bold uppercase tracking-wider rounded-md border ${style} ${sizeClass} ${className}`}
    >
      <span className={`h-1.5 w-1.5 rounded-full ${dotColor} ${pulse ? 'animate-pulse' : ''}`} />
      <span>{status}</span>
    </span>
  );
}
</file>

<file path="apps/web/src/components/AppearanceToggle.tsx">
import { useLayoutEffect, useState } from 'react';
import { Moon, Sun } from 'lucide-react';

const APPEARANCE_KEY = 'proton_appearance';
type Appearance = 'light' | 'dark';

export default function AppearanceToggle() {
  const [appearance, setAppearance] = useState<Appearance>(() =>
    localStorage.getItem(APPEARANCE_KEY) === 'dark' ? 'dark' : 'light'
  );
  const isDark = appearance === 'dark';

  useLayoutEffect(() => {
    document.documentElement.dataset.theme = appearance;
    document.documentElement.style.colorScheme = appearance;
  }, [appearance]);

  const toggleAppearance = () => {
    const nextAppearance = isDark ? 'light' : 'dark';
    localStorage.setItem(APPEARANCE_KEY, nextAppearance);
    setAppearance(nextAppearance);
  };

  return (
    <button
      type="button"
      className="proton-theme-toggle"
      onClick={toggleAppearance}
      aria-label={`Switch to ${isDark ? 'light' : 'dark'} mode`}
      title={`Switch to ${isDark ? 'light' : 'dark'} mode`}
      aria-pressed={isDark}
    >
      {isDark ? <Sun size={16} strokeWidth={1.8} /> : <Moon size={16} strokeWidth={1.8} />}
      <span>{isDark ? 'Light' : 'Dark'}</span>
    </button>
  );
}
</file>

<file path="apps/web/src/components/ClassicLayout.tsx">
import { useState, useEffect, type ReactNode } from 'react';
import { NavLink, useNavigate, useLocation } from 'react-router-dom';
import { 
  Users, 
  Settings, 
  LogOut, 
  FileText, 
  Search, 
  CheckSquare, 
  Activity,
  MessageSquareText,
  CalendarDays,
} from 'lucide-react';
import { useMedplum } from '@medplum/react';
import AppearanceToggle from './AppearanceToggle';
import CommandPalette from './ui/CommandPalette';

interface LayoutProps {
  children: ReactNode;
  fullBleed?: boolean;
  fillCanvas?: boolean;
  canvasBg?: string;
}

export default function Layout({ 
  children,
  fullBleed = false,
  fillCanvas = false,
  canvasBg = 'bg-[#fafaf9]'
}: LayoutProps) {
  const medplum = useMedplum();
  const navigate = useNavigate();
  const location = useLocation();
  const [isCommandPaletteOpen, setIsCommandPaletteOpen] = useState(false);

  const handleLogout = () => {
    medplum.signOut().then(() => {
      navigate('/login');
    });
  };

  // Keyboard shortcut listener for ⌘K / Ctrl+K
  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        const activeTag = document.activeElement?.tagName?.toLowerCase();
        if (activeTag !== 'input' && activeTag !== 'textarea') {
          e.preventDefault();
          setIsCommandPaletteOpen((prev) => !prev);
        }
      }
    };
    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, []);

  // Primary navigation specified: Today, Patients, Consultations, Documents, Review
  const primaryNavItems = [
    { to: '/', icon: CalendarDays, label: 'Today', end: true },
    { to: '/patients', icon: Users, label: 'Patients' },
    { to: '/consultation', icon: Activity, label: 'Consultations' },
    { to: '/document-review', icon: FileText, label: 'Documents' },
    { to: '/review', icon: CheckSquare, label: 'Review' },
    { to: '/assistant', icon: MessageSquareText, label: 'Assistant' },
  ];

  const isActive = (path: string, end?: boolean) => {
    if (end) return location.pathname === path;
    return location.pathname.startsWith(path);
  };

  return (
    <div className="proton-classic-shell flex h-screen bg-[#fafaf9] text-zinc-900 font-sans antialiased overflow-hidden">
      {/* ── Sidebar (Calm Clinical Workspace Shell) ── */}
      <aside className="w-56 bg-white border-r border-zinc-200 flex flex-col shrink-0">
        
        {/* Brand Header */}
        <div className="px-5 py-4 border-b border-zinc-200/80 flex items-center justify-between">
          <div className="flex items-center gap-2.5">
            <div className="w-7 h-7 rounded-lg bg-zinc-900 text-white flex items-center justify-center font-bold text-xs shadow-xs">
              P
            </div>
            <div>
              <span className="font-bold text-sm tracking-tight text-zinc-900 leading-none block">
                Proton
              </span>
              <span className="text-[10px] text-zinc-400 font-medium">Physician Desk</span>
            </div>
          </div>
          <span className="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
            <span className="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse" />
            Live
          </span>
        </div>

        {/* Search Input Trigger */}
        <div className="px-3 pt-3 pb-2">
          <button
            onClick={() => setIsCommandPaletteOpen(true)}
            className="w-full flex items-center justify-between px-2.5 py-1.5 text-xs text-zinc-500 bg-zinc-50 hover:bg-zinc-100 hover:text-zinc-800 border border-zinc-200 rounded-md transition-colors cursor-pointer"
            title="Search patients or execute actions (⌘K)"
          >
            <span className="flex items-center gap-2">
              <Search size={13} className="text-zinc-400" />
              <span>Search patients</span>
            </span>
            <kbd className="text-[10px] text-zinc-400 font-sans border border-zinc-200 px-1 rounded bg-white">
              ⌘K
            </kbd>
          </button>
        </div>

        {/* Primary Navigation */}
        <nav className="flex-1 px-3 py-2 space-y-0.5">
          {primaryNavItems.map((item) => {
            const active = isActive(item.to, item.end);
            return (
              <NavLink
                key={item.to}
                to={item.to}
                end={item.end}
                className={`flex items-center gap-2.5 px-2.5 py-1.5 rounded-md text-xs font-medium transition-colors ${
                  active
                    ? 'bg-zinc-100 text-zinc-900 font-semibold'
                    : 'text-zinc-600 hover:bg-zinc-50 hover:text-zinc-900'
                }`}
              >
                <item.icon 
                  size={15} 
                  strokeWidth={active ? 2.25 : 1.75} 
                  className={active ? 'text-zinc-900' : 'text-zinc-400'} 
                />
                <span>{item.label}</span>
              </NavLink>
            );
          })}
        </nav>

        {/* Physician Profile Card */}
        <div className="p-2.5 mx-3 mb-2 rounded-xl bg-zinc-50 border border-zinc-200/80 flex items-center gap-2.5">
          <div className="w-8 h-8 rounded-lg bg-zinc-900 text-white font-bold text-xs flex items-center justify-center shrink-0">
            DP
          </div>
          <div className="min-w-0 flex-1">
            <div className="text-xs font-semibold text-zinc-900 truncate">Dr. Physician, MD</div>
            <div className="text-[10px] text-zinc-500 truncate">Attending • Internal Med</div>
          </div>
        </div>

        {/* Secondary: Settings & Sign Out */}
        <div className="px-3 py-3 border-t border-zinc-200 space-y-0.5">
          <NavLink
