                    </div>
                  </div>
                </>
              )}

              {/* SEP ECG MODAL */}
              {activeModal === 'sep-ecg' && (
                <>
                  <h3 className="text-xl font-bold text-[#141a16]">12-Lead ECG Interpretation</h3>
                  <p className="text-xs text-[#718076]">Recorded Sep 14, 2022 &bull; Ambulatory Holter Follow-Up</p>

                  <div className="bg-white p-4 rounded-2xl border border-black/5 space-y-2 text-xs">
                    <div className="flex justify-between">
                      <span className="text-[#718076]">Rhythm</span>
                      <span className="font-bold text-[#161c18]">Normal Sinus Rhythm (NSR)</span>
                    </div>
                    <div className="flex justify-between">
                      <span className="text-[#718076]">Ventricular Rate</span>
                      <span className="font-semibold text-[#161c18]">84 bpm</span>
                    </div>
                    <div className="flex justify-between">
                      <span className="text-[#718076]">PR Interval / QRS</span>
                      <span className="font-semibold text-[#161c18]">164 ms / 88 ms</span>
                    </div>
                    <div className="flex justify-between">
                      <span className="text-[#718076]">QTc Interval</span>
                      <span className="font-semibold text-[#161c18]">428 ms (Normal &lt; 450 ms)</span>
                    </div>
                    <div className="flex justify-between">
                      <span className="text-[#718076]">ST-T Segment</span>
                      <span className="font-semibold text-[#161c18]">Non-specific repolarization changes in V2-V3</span>
                    </div>
                  </div>
                </>
              )}

              {/* MRI SCAN MODAL */}
              {activeModal === 'mri-scan' && (
                <>
                  <h3 className="text-xl font-bold text-[#141a16]">Brain MRI (Axial T2 / FLAIR)</h3>
                  <p className="text-xs text-[#718076]">Study Date: August 12, 2022 &bull; DICOM Reference #MR-9041</p>

                  <div className="h-44 w-full bg-black rounded-2xl overflow-hidden flex items-center justify-center">
                    <img 
                      src="/assets/mri-scan.png" 
                      alt="Brain MRI Axial Slice" 
                      className="h-full object-contain"
                    />
                  </div>

                  <div className="bg-white p-3.5 rounded-2xl border border-black/5 text-xs space-y-1.5">
                    <div className="font-bold text-[#161c18]">Radiologist Findings:</div>
                    <p className="text-[#556358] leading-relaxed">
                      No acute territorial infarct, intracranial hemorrhage, or hydrocephalus. Mild chronic microvascular ischemic white matter changes (Fazekas Grade 1) compatible with long-standing hypertension.
                    </p>
                  </div>
                </>
              )}

              {/* TRAJECTORY MODAL */}
              {activeModal === 'today-trajectory' && (
                <>
                  <h3 className="text-xl font-bold text-[#141a16]">Cardiovascular risk summary</h3>
                  <p className="text-xs text-[#718076]">Change over time</p>

                  <div className="bg-white p-4 rounded-2xl border border-black/5 space-y-2 text-xs">
                    <div className="flex justify-between">
                      <span className="text-[#718076]">10-Year ASCVD Risk</span>
                      <span className="font-bold text-emerald-700">Reduced from 18.4% to 13.2% (-28%)</span>
                    </div>
                    <div className="flex justify-between">
                      <span className="text-[#718076]">Renal Protection (eGFR)</span>
                      <span className="font-semibold text-[#161c18]">68 mL/min/1.73m² (Stable CKD 2)</span>
                    </div>
                    <div className="flex justify-between">
                      <span className="text-[#718076]">Medication Adherence</span>
                      <span className="font-semibold text-[#161c18]">98% (Pharmacy Fill Sync)</span>
                    </div>
                  </div>
                </>
              )}

              {/* MILESTONE MODALS */}
              {(activeModal === 'aug-milestone' || activeModal === 'sep-milestone' || activeModal === 'today-milestone') && (
                <>
                  <h3 className="text-xl font-bold text-[#141a16]">
                    {activeModal === 'aug-milestone' ? 'August Clinical Encounter' :
                     activeModal === 'sep-milestone' ? 'September Titration Encounter' :
                     'Today Clinical Evaluation'}
                  </h3>
                  <p className="text-xs text-[#718076]">Longitudinal Record &bull; Patient: {patientName}</p>

                  <div className="bg-white p-4 rounded-2xl border border-black/5 text-xs space-y-2">
                    <div className="font-semibold text-[#161c18]">Clinical Summary:</div>
                    <p className="text-[#556358] leading-relaxed">
                      {activeModal === 'aug-milestone' ? 'Initial evaluation for severe uncontrolled hypertension with headache. Initiated diagnostic imaging and baseline cardioprotection.' :
                       activeModal === 'sep-milestone' ? 'Step-up titration with cardioselective beta-blocker Bisoprolol. Marked hemodynamic response and complete resolution of cephalalgia.' :
                       'Current stable ambulatory status. Triple guideline-directed therapy maintained with target BP and stable renal indices.'}
                    </p>
                  </div>
                </>
              )}

            </div>

            {/* Modal Footer */}
            <div className="bg-[#e9ede4] px-6 py-3 border-t border-black/5 flex items-center justify-between">
              <button
                onClick={handleLaunchConsult}
                className="text-xs font-bold text-[#141a16] hover:text-brand-700 flex items-center gap-1 cursor-pointer"
              >
                <span>Start consultation</span>
                <ArrowRight size={13} />
              </button>

              <button
                onClick={() => setActiveModal(null)}
                className="px-4 py-1.5 rounded-full text-xs font-bold bg-[#1b211d] text-white hover:bg-black transition-colors cursor-pointer"
              >
                Close
              </button>
            </div>

          </div>
        </div>
      )}

    </div>
  );
}
