  place-items: center;
  border-radius: 11px;
  background: var(--workspace-accent);
  color: #1b281f;
  box-shadow: 0 5px 18px rgba(199, 232, 121, 0.15);
}

.proton-brand-word {
  font-size: 20px;
  font-weight: 650;
  letter-spacing: -0.055em;
}

.proton-brand-word span {
  color: var(--workspace-accent);
}

.proton-brand-caption {
  align-self: center;
  margin: 2px 0 0 auto;
  color: #8c9a90;
  font-family: var(--font-mono);
  font-size: 8px;
  letter-spacing: 0.12em;
}

.proton-search-trigger {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  margin: 34px 0 27px;
  padding: 10px 11px;
  border: 1px solid rgba(238, 243, 232, 0.1);
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.045);
  color: #bdc7be;
  font: inherit;
  font-size: 12px;
  text-align: left;
  cursor: pointer;
  transition: background 160ms ease, border-color 160ms ease, color 160ms ease;
}

.proton-search-trigger:hover {
  border-color: rgba(199, 232, 121, 0.34);
  background: rgba(255, 255, 255, 0.08);
  color: #fff;
}

.proton-search-trigger kbd {
  display: flex;
  align-items: center;
  gap: 3px;
  margin-left: auto;
  padding: 3px 5px;
  border: 1px solid rgba(238, 243, 232, 0.13);
  border-radius: 5px;
  color: #9ba79e;
  font-family: var(--font-mono);
  font-size: 9px;
}

.proton-nav-label {
  padding: 0 11px 10px;
  color: #78867c;
  font-family: var(--font-mono);
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 0.14em;
}

.proton-primary-nav,
.proton-sidebar-footer {
  display: grid;
  gap: 4px;
}

.proton-nav-link {
  position: relative;
  display: flex;
  min-height: 40px;
  align-items: center;
  gap: 11px;
  padding: 0 11px;
  border: 0;
  border-radius: 9px;
  background: transparent;
  color: #aab5ac;
  font: inherit;
  font-size: 12px;
  font-weight: 500;
  text-align: left;
  text-decoration: none;
  cursor: pointer;
  transition: background 160ms ease, color 160ms ease;
}

.proton-nav-link:hover {
  background: rgba(255, 255, 255, 0.065);
  color: #fff;
}

.proton-nav-link.is-active {
  background: rgba(199, 232, 121, 0.12);
  color: #e5f4c5;
}

.proton-nav-link.is-active::before {
  position: absolute;
  top: 10px;
  bottom: 10px;
  left: 0;
  width: 2px;
  border-radius: 3px;
  background: var(--workspace-accent);
  content: "";
}

.proton-sidebar-spacer {
  flex: 1;
  min-height: 18px;
}

.proton-safety-card {
  display: flex;
  gap: 10px;
  margin: 12px 2px 16px;
  padding: 13px 11px;
  border: 1px solid rgba(199, 232, 121, 0.13);
  border-radius: 11px;
  background: rgba(199, 232, 121, 0.055);
}

.proton-safety-icon {
  display: grid;
  flex: 0 0 27px;
  height: 27px;
  place-items: center;
  border-radius: 8px;
  background: rgba(199, 232, 121, 0.13);
  color: var(--workspace-accent);
}

.proton-safety-title {
  margin: 1px 0 4px;
  color: #e5ebdf;
  font-size: 10px;
  font-weight: 600;
}

.proton-safety-card p {
  margin: 0;
  color: #9eaaa0;
  font-size: 9px;
  line-height: 1.55;
}

.proton-sidebar-footer {
  padding-top: 10px;
  border-top: 1px solid rgba(238, 243, 232, 0.09);
}

.proton-signout:hover {
  color: #ffc2b7;
}

.proton-evaluator-profile {
  display: flex;
  align-items: center;
  gap: 9px;
  margin: 11px 1px 0;
  padding: 12px 5px 0;
  border-top: 1px solid rgba(238, 243, 232, 0.08);
}

.proton-avatar {
  display: grid;
  flex: 0 0 31px;
  height: 31px;
  place-items: center;
  border: 1px solid rgba(199, 232, 121, 0.3);
  border-radius: 50%;
  background: rgba(199, 232, 121, 0.12);
  color: #d9eeac;
  font-family: var(--font-mono);
  font-size: 9px;
}

.proton-profile-copy {
  display: grid;
  gap: 3px;
  min-width: 0;
  color: #e2e8e1;
  font-size: 10px;
  font-weight: 500;
}

.proton-profile-copy small {
  color: #87948a;
  font-size: 9px;
  font-weight: 400;
}

.proton-profile-arrow {
  margin-left: auto;
  color: #78867c;
}

.proton-workspace-main {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  overflow: hidden;
}

.proton-topbar {
  position: relative;
  z-index: 4;
  display: flex;
  min-height: 77px;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 12px 34px;
  border-bottom: 1px solid var(--workspace-line);
  background: rgba(255, 255, 255, 0.86);
  backdrop-filter: blur(16px);
}

.proton-breadcrumb {
  margin-bottom: 4px;
  color: #98a198;
  font-family: var(--font-mono);
  font-size: 8px;
  font-weight: 600;
  letter-spacing: 0.12em;
}

.proton-breadcrumb span {
  padding: 0 5px;
  color: #c5cbc3;
}

.proton-topbar-context h1 {
  margin: 0;
  color: #1a261f;
  font-size: 16px;
  font-weight: 600;
  letter-spacing: -0.025em;
}

.proton-topbar-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.proton-environment-pill {
  display: inline-flex;
  min-height: 29px;
  align-items: center;
  gap: 7px;
  padding: 0 10px;
  border: 1px solid #e4ead9;
  border-radius: 100px;
  background: #f7faef;
  color: #647448;
  font-family: var(--font-mono);
  font-size: 8px;
  font-weight: 600;
  letter-spacing: 0.055em;
  white-space: nowrap;
}

.proton-topbar-search {
  display: grid;
  width: 34px;
  height: 34px;
  place-items: center;
  border: 1px solid #e5e9e2;
  border-radius: 9px;
  background: #fff;
  color: #69756b;
  cursor: pointer;
  transition: border-color 160ms ease, color 160ms ease;
}

.proton-topbar-search:hover {
  border-color: #bdce9b;
  color: #31422f;
}

.proton-start-visit {
  display: inline-flex;
  min-height: 35px;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 0 13px;
  border: 1px solid #19261e;
  border-radius: 9px;
  background: #19261e;
  color: #f5f7f2;
  font: inherit;
  font-size: 11px;
  font-weight: 550;
  cursor: pointer;
  transition: transform 160ms ease, background 160ms ease;
}

.proton-start-visit:hover {
  transform: translateY(-1px);
  background: #27382c;
}

.proton-workspace-canvas {
  flex: 1;
  overflow: auto;
  overscroll-behavior: contain;
}

.proton-canvas-content {
  width: min(100%, 1480px);
  margin: 0 auto;
  padding: 30px 34px 48px;
}

.proton-canvas-content.is-full-bleed {
  width: 100%;
  padding: 0;
}

.proton-canvas-content.is-fill-canvas {
  display: flex;
  height: 100%;
  flex-direction: column;
}

.proton-mobile-nav {
  display: none;
}

.proton-workspace-shell button:focus-visible,
.proton-workspace-shell a:focus-visible {
  outline: 2px solid #a4c765;
  outline-offset: 2px;
}

@media (max-width: 1000px) {
  .proton-sidebar {
    flex-basis: 220px;
  }

  .proton-topbar {
    padding-right: 22px;
    padding-left: 22px;
  }

  .proton-canvas-content {
    padding-right: 22px;
    padding-left: 22px;
  }
}

@media (max-width: 760px) {
  .proton-workspace-shell {
    display: block;
  }

  .proton-sidebar {
    display: none;
  }

  .proton-workspace-main {
    height: 100%;
  }

  .proton-topbar {
    min-height: 66px;
    padding: 10px 16px;
  }

  .proton-topbar-context h1 {
    font-size: 15px;
  }

  .proton-breadcrumb {
    font-size: 7px;
  }

  .proton-topbar-actions {
    gap: 7px;
  }

  .proton-environment-pill {
    padding: 0 7px;
    font-size: 7px;
  }

  .proton-topbar-search {
    width: 32px;
    height: 32px;
  }

  .proton-start-visit {
    min-height: 32px;
    padding: 0 9px;
  }

  .proton-start-visit span {
    display: none;
  }

  .proton-mobile-nav {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 4px;
    padding: 8px 12px;
    border-bottom: 1px solid var(--workspace-line);
    background: #fff;
  }

  .proton-mobile-nav-link {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    min-width: 0;
    min-height: 52px;
    gap: 4px;
    padding: 6px 4px;
    border-radius: var(--radius-control);
    color: #738076;
    font-size: 10px;
    font-weight: 500;
    text-decoration: none;
    text-align: center;
  }

  .proton-mobile-nav-link.is-active {
    background: #eff4e6;
    color: #35482e;
  }

  .proton-canvas-content {
    padding: 20px 15px 34px;
  }

  .proton-canvas-content.is-full-bleed {
    padding: 0;
  }
}

@media (max-width: 420px) {
  .proton-topbar {
    gap: 8px;
  }

  .proton-environment-pill {
    max-width: 90px;
    overflow: hidden;
    text-overflow: ellipsis;
  }

}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* Clinical command center */
