  .proton-workspace-shell .proton-mobile-nav,
  .proton-classic-mobile-nav {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-1);
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--workspace-border);
