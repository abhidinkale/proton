                      <span className="text-[#718076]">Target Compliance</span>
                      <span className="font-bold text-emerald-700">Within Safe Limits</span>
                    </div>
                    <div className="flex justify-between">
                      <span className="text-[#718076]">Resting Heart Rate</span>
                      <span className="font-semibold text-[#161c18]">84-86 bpm</span>
