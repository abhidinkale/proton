/* Shared workspace rules: keep the clinical UI quiet and consistent across pages. */
:is(.proton-workspace-shell, .proton-classic-shell) {
  --workspace-space-1: 0.25rem;
  --workspace-space-2: 0.5rem;
  --workspace-space-3: 0.75rem;
  --workspace-space-4: 1rem;
  --workspace-space-6: 1.5rem;
  --workspace-space-8: 2rem;
  --workspace-control-radius: 0.5rem;
  --workspace-card-radius: 0.75rem;
  --workspace-dialog-radius: 1rem;
  --workspace-border: #e5e5e5;
  --workspace-surface: #fff;
  --workspace-canvas: #f8f8f8;
  --workspace-text: #171717;
  --workspace-muted: #737373;
  font-family: var(--font-sans);
  color: var(--workspace-text);
}

:is(.proton-workspace-shell, .proton-classic-shell) .proton-workspace-canvas {
  background: var(--workspace-canvas) !important;
}

.proton-workspace-shell .proton-topbar,
.proton-workspace-shell .proton-mobile-nav {
  background: var(--workspace-surface) !important;
  backdrop-filter: none;
}

:is(.proton-workspace-shell, .proton-classic-shell) :is(.proton-card, .proton-patient-banner, .proton-dashboard-visits, .proton-patient-intelligence, .proton-consultation-workspace, .proton-document-workspace, .proton-preconsultation-brief, .proton-during-consult-context, .proton-dynamics-panel) {
  border-radius: var(--workspace-card-radius) !important;
  box-shadow: none !important;
}

:is(.proton-workspace-shell, .proton-classic-shell) :is([class~="rounded-2xl"], [class~="rounded-3xl"]) {
  border-radius: var(--workspace-card-radius) !important;
}

:is(.proton-workspace-shell, .proton-classic-shell) :is([class~="rounded-xl"], [class~="rounded-lg"], [class~="rounded-md"]) {
  border-radius: var(--workspace-control-radius) !important;
}

:is(.proton-workspace-shell, .proton-classic-shell) :is([class~="shadow-lg"], [class~="shadow-xl"], [class~="shadow-2xl"]) {
  box-shadow: none !important;
}

:is(.proton-workspace-shell, .proton-classic-shell) :is(button, a) {
  transition-property: color, background-color, border-color, opacity !important;
  transition-duration: 140ms !important;
  transition-timing-function: ease-out !important;
}

:is(.proton-workspace-shell, .proton-classic-shell) :is(button, a):not(:disabled):hover {
  transform: none !important;
}

:is(.proton-workspace-shell, .proton-classic-shell) :is(button, a, input, select, textarea):focus-visible {
  outline: 2px solid #737373;
  outline-offset: 2px;
}

