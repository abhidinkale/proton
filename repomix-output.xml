<file path="apps/web/src/components/ui/CommandPalette.tsx">
import { useState, useEffect, useRef, useMemo, type ReactNode } from 'react';
import { useNavigate } from 'react-router-dom';
import { useMedplum } from '@medplum/react';
import type { Patient } from '@medplum/fhirtypes';
import { 
  Search, 
  LayoutDashboard, 
  Users, 
  Mic, 
  FileText, 
  ChevronRight, 
  X,
  Stethoscope,
  ShieldCheck
} from 'lucide-react';

interface CommandPaletteProps {
  isOpen: boolean;
  onClose: () => void;
}

interface PaletteAction {
  id: string;
  category: 'NAVIGATION' | 'WORKFLOW' | 'PATIENT';
  title: string;
  subtitle?: string;
  shortcut?: string;
  icon: ReactNode;
  onSelect: () => void;
}

export default function CommandPalette({ isOpen, onClose }: CommandPaletteProps) {
  const navigate = useNavigate();
  const medplum = useMedplum();
  const [query, setQuery] = useState('');
  const [patients, setPatients] = useState<Patient[]>([]);
  const [selectedIndex, setSelectedIndex] = useState(0);
  const inputRef = useRef<HTMLInputElement>(null);

  // Fetch patients when opened
  useEffect(() => {
    if (isOpen) {
      setQuery('');
      setSelectedIndex(0);
      setTimeout(() => inputRef.current?.focus(), 50);
      medplum.searchResources('Patient', { _count: 30, _sort: '-_lastUpdated' })
        .then(setPatients)
        .catch(console.error);
    }
  }, [isOpen, medplum]);

  // Global Keyboard listener for ⌘K / Ctrl+K
  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (isOpen) {
          onClose();
        } else {
          // Open handled by parent or state
        }
      } else if (e.key === 'Escape' && isOpen) {
        e.preventDefault();
        onClose();
      }
    };
    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, [isOpen, onClose]);

  const getPatientName = (p: Patient): string => {
    const n = p.name?.[0];
    return n ? `${n.given?.join(' ') || ''} ${n.family || ''}`.trim() : 'Patient ' + (p.id?.slice(0, 8) || '');
  };

  // Compile actions
  const actions = useMemo<PaletteAction[]>(() => {
    const list: PaletteAction[] = [];
    const q = query.toLowerCase().trim();

    // Standard Quick Actions
    const standardWorkflows: PaletteAction[] = [
      {
        id: 'act-cmd',
        category: 'NAVIGATION',
        title: 'Go to Command Center',
        subtitle: "Today's Clinical Workspace & Attention Center",
        shortcut: 'G C',
        icon: <LayoutDashboard size={16} className="text-brand-600" />,
        onSelect: () => {
          navigate('/');
          onClose();
        }
      },
      {
        id: 'act-patients',
        category: 'NAVIGATION',
        title: 'View Patient Directory',
        subtitle: 'All synthetic clinical patient profiles',
        shortcut: 'G P',
        icon: <Users size={16} className="text-slate-600" />,
        onSelect: () => {
          navigate('/patients');
          onClose();
        }
      },
      {
        id: 'act-new-consult',
        category: 'WORKFLOW',
        title: 'Start New Consultation',
        subtitle: 'Launch clinical dialogue capture & copilot',
        shortcut: 'N C',
        icon: <Mic size={16} className="text-emerald-600" />,
        onSelect: () => {
          navigate('/consultation');
          onClose();
        }
      },
      {
        id: 'act-review-center',
        category: 'WORKFLOW',
        title: 'Open Review Center',
        subtitle: 'Verify unconfirmed AI facts & document intake',
        shortcut: 'G R',
        icon: <ShieldCheck size={16} className="text-amber-600" />,
        onSelect: () => {
          navigate('/document-review');
          onClose();
        }
      },
      {
        id: 'act-doc-review',
        category: 'WORKFLOW',
        title: 'Upload Previous Clinical Records',
        subtitle: 'Ingest lab reports, discharge summaries & PDFs',
        icon: <FileText size={16} className="text-blue-600" />,
        onSelect: () => {
          navigate('/document-review');
          onClose();
        }
      },
      {
        id: 'act-settings',
        category: 'NAVIGATION',
        title: 'Settings & Clinical Policies',
        subtitle: 'Physician identity, AI engine parameters & safety rules',
        shortcut: 'G S',
        icon: <LayoutDashboard size={16} className="text-slate-600" />,
        onSelect: () => {
          navigate('/settings');
          onClose();
        }
      }
    ];

    if (!q) {
      list.push(...standardWorkflows);
    } else {
      // Filter standard actions
      const matchedWorkflows = standardWorkflows.filter(
        a => a.title.toLowerCase().includes(q) || (a.subtitle && a.subtitle.toLowerCase().includes(q))
      );
      list.push(...matchedWorkflows);
    }

    // Patient Results
    const matchingPatients = patients.filter(p => {
      if (!q) return true;
      const name = getPatientName(p).toLowerCase();
      const mrn = (p.id || '').toLowerCase();
      return name.includes(q) || mrn.includes(q);
    }).slice(0, 8);

    matchingPatients.forEach(p => {
      const name = getPatientName(p);
      list.push({
        id: `pat-${p.id}`,
        category: 'PATIENT',
        title: name,
        subtitle: `DOB: ${p.birthDate || 'Unknown'} • MRN: ${p.id?.slice(0, 8)} • Open Profile`,
        icon: <Stethoscope size={16} className="text-brand-600" />,
        onSelect: () => {
          navigate(`/patients/${p.id}`);
          onClose();
        }
      });
    });

    return list;
  }, [query, patients, navigate, onClose]);

  // Reset selected index when actions change
  useEffect(() => {
    setSelectedIndex(0);
  }, [actions.length, query]);

  const handleKeyDown = (e: React.KeyboardEvent<HTMLInputElement>) => {
    if (actions.length === 0) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      setSelectedIndex(prev => (prev + 1) % actions.length);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setSelectedIndex(prev => (prev - 1 + actions.length) % actions.length);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      const action = actions[selectedIndex];
      if (action) {
        action.onSelect();
      }
    }
  };

  if (!isOpen) return null;

  return (
    <div className="fixed inset-0 z-50 flex items-start justify-center pt-20 px-4 bg-slate-950/40 backdrop-blur-sm animate-in fade-in duration-150">
      <div 
        className="bg-white rounded-2xl shadow-2xl border border-slate-200/90 w-full max-w-xl overflow-hidden animate-in zoom-in-95 duration-150 flex flex-col max-h-[80vh]"
        onClick={(e) => e.stopPropagation()}
      >
        {/* Search Input Bar */}
        <div className="relative border-b border-slate-200 px-4 py-3.5 flex items-center gap-3">
          <Search size={18} className="text-slate-400 shrink-0" />
          <input
            ref={inputRef}
            type="text"
            value={query}
            onChange={(e) => setQuery(e.target.value)}
            onKeyDown={handleKeyDown}
            placeholder="Search patients, actions, or jump to workspace..."
            className="flex-1 bg-transparent text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none font-medium"
          />
          {query && (
            <button
              onClick={() => setQuery('')}
              className="text-slate-400 hover:text-slate-600 p-0.5 rounded cursor-pointer"
            >
              <X size={14} />
            </button>
          )}
          <kbd className="hidden sm:inline-flex items-center px-1.5 py-0.5 text-[10px] font-mono text-slate-500 bg-slate-100 border border-slate-200 rounded">
            ESC
          </kbd>
        </div>

        {/* Results List */}
        <div className="overflow-y-auto divide-y divide-slate-100 flex-1 p-2">
          {actions.length === 0 ? (
            <div className="p-8 text-center text-slate-500 text-xs">
              No matching patients or actions found.
            </div>
          ) : (
            actions.map((act, idx) => {
              const isSelected = idx === selectedIndex;
              return (
                <div
                  key={act.id}
                  onMouseEnter={() => setSelectedIndex(idx)}
                  onClick={act.onSelect}
                  className={`px-3.5 py-2.5 rounded-xl flex items-center justify-between gap-3 cursor-pointer transition-colors ${
                    isSelected ? 'bg-brand-50 text-brand-950' : 'hover:bg-slate-50 text-slate-800'
                  }`}
                >
                  <div className="flex items-center gap-3 min-w-0">
                    <div className={`p-2 rounded-lg shrink-0 ${isSelected ? 'bg-white shadow-2xs' : 'bg-slate-100'}`}>
                      {act.icon}
                    </div>
                    <div className="min-w-0">
                      <div className="flex items-center gap-2">
                        <span className="font-semibold text-sm truncate">{act.title}</span>
                        {act.category === 'PATIENT' && (
                          <span className="text-[10px] uppercase font-bold px-1.5 py-0.2 rounded bg-slate-100 text-slate-600">
                            Patient
                          </span>
                        )}
                      </div>
                      {act.subtitle && (
                        <p className="text-xs text-slate-500 truncate mt-0.5">{act.subtitle}</p>
                      )}
                    </div>
                  </div>

                  <div className="flex items-center gap-2 shrink-0">
                    {act.shortcut && (
                      <kbd className="hidden md:inline-flex text-[10px] font-mono text-slate-400 bg-slate-50 px-1.5 py-0.5 rounded border border-slate-200">
                        {act.shortcut}
                      </kbd>
                    )}
                    <ChevronRight size={14} className={isSelected ? 'text-brand-600' : 'text-slate-300'} />
                  </div>
                </div>
              );
            })
          )}
        </div>

        {/* Footer Shortcut Bar */}
        <div className="bg-slate-50 px-4 py-2 border-t border-slate-200 flex items-center justify-between text-[11px] text-slate-500 shrink-0">
          <div className="flex items-center gap-4">
            <span className="flex items-center gap-1">
              <kbd className="px-1 py-0.5 bg-white border border-slate-200 rounded font-mono text-[10px]">↑↓</kbd> Navigate
            </span>
            <span className="flex items-center gap-1">
              <kbd className="px-1 py-0.5 bg-white border border-slate-200 rounded font-mono text-[10px]">↵</kbd> Select
            </span>
            <span className="flex items-center gap-1">
              <kbd className="px-1 py-0.5 bg-white border border-slate-200 rounded font-mono text-[10px]">ESC</kbd> Close
            </span>
          </div>
          <span className="font-medium text-brand-700">
            Proton Command Palette
          </span>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="apps/web/src/components/ui/ProvenanceBadge.tsx">
import type { ReactNode } from 'react';
import { Edit3, ShieldCheck, XCircle, FileText, CheckCircle2 } from 'lucide-react';

export type ProvenanceType = 
  | 'AI_DRAFT'
  | 'AI_EXTRACTED'
  | 'AI_INFERRED'
  | 'PHYSICIAN_EDITED'
  | 'PHYSICIAN_APPROVED'
  | 'CONFIRMED_FACT'
  | 'REJECTED';

interface ProvenanceBadgeProps {
  provenance: ProvenanceType | string;
  onViewEvidence?: () => void;
  size?: 'xs' | 'sm' | 'md';
  className?: string;
  interactive?: boolean;
}

export default function ProvenanceBadge({
  provenance,
  onViewEvidence,
  size = 'sm',
  className = '',
  interactive = false
}: ProvenanceBadgeProps) {
  const norm = provenance.toUpperCase().replace(/\s+/g, '_');

  let config: {
    label: string;
    bg: string;
    text: string;
    border: string;
    icon: ReactNode;
    description: string;
  };

  switch (norm) {
    case 'AI_DRAFT':
    case 'AI_SUGGESTED':
      config = {
        label: 'AI DRAFT',
        bg: 'bg-violet-50',
        text: 'text-violet-800',
        border: 'border-violet-200',
        icon: <FileText size={size === 'xs' ? 10 : 12} className="text-violet-600 shrink-0" />,
        description: 'AI-generated draft • Physician review required'
      };
      break;
    case 'AI_EXTRACTED':
      config = {
        label: 'AI EXTRACTED',
        bg: 'bg-indigo-50',
        text: 'text-indigo-800',
        border: 'border-indigo-200',
        icon: <FileText size={size === 'xs' ? 10 : 12} className="text-indigo-600 shrink-0" />,
        description: 'Extracted from source records • Pending physician confirmation'
      };
      break;
    case 'AI_INFERRED':
    case 'AI_SYNTHESIS':
      config = {
        label: 'AI INFERRED',
        bg: 'bg-purple-50',
        text: 'text-purple-800',
        border: 'border-purple-200',
        icon: <FileText size={size === 'xs' ? 10 : 12} className="text-purple-600 shrink-0" />,
        description: 'AI-inferred • Physician review required'
      };
      break;
    case 'PHYSICIAN_EDITED':
    case 'DOCTOR_EDITED':
      config = {
        label: 'PHYSICIAN EDITED',
        bg: 'bg-sky-50',
        text: 'text-sky-800',
        border: 'border-sky-200',
        icon: <Edit3 size={size === 'xs' ? 10 : 12} className="text-sky-600 shrink-0" />,
        description: 'Directly modified by treating physician'
      };
      break;
    case 'PHYSICIAN_APPROVED':
    case 'DOCTOR_APPROVED':
      config = {
        label: 'PHYSICIAN APPROVED',
        bg: 'bg-emerald-50',
        text: 'text-emerald-800',
        border: 'border-emerald-200',
        icon: <ShieldCheck size={size === 'xs' ? 10 : 12} className="text-emerald-600 shrink-0" />,
        description: 'Explicitly verified and signed by physician'
      };
      break;
    case 'CONFIRMED_FACT':
      config = {
        label: 'CONFIRMED FACT',
        bg: 'bg-teal-50',
        text: 'text-teal-800',
        border: 'border-teal-200',
        icon: <CheckCircle2 size={size === 'xs' ? 10 : 12} className="text-teal-600 shrink-0" />,
        description: 'Persisted in clinical memory with physician sign-off'
      };
      break;
    case 'REJECTED':
      config = {
        label: 'REJECTED',
        bg: 'bg-slate-100',
        text: 'text-slate-600',
        border: 'border-slate-200',
        icon: <XCircle size={size === 'xs' ? 10 : 12} className="text-slate-500 shrink-0" />,
        description: 'Rejected by physician • Excluded from clinical memory'
      };
      break;
    default:
      config = {
        label: provenance,
        bg: 'bg-slate-100',
        text: 'text-slate-700',
        border: 'border-slate-200',
        icon: null,
        description: 'Clinical record entry'
      };
  }

  const sizeClass = size === 'xs'
    ? 'px-1.5 py-0.2 text-[9px] gap-1'
    : size === 'md'
    ? 'px-2.5 py-1 text-xs gap-1.5'
    : 'px-2 py-0.5 text-[10px] gap-1.2';

  const isClickable = interactive && !!onViewEvidence;

  return (
    <span
      onClick={isClickable ? onViewEvidence : undefined}
      title={config.description}
      className={`inline-flex items-center font-bold uppercase tracking-wider rounded-md border ${config.bg} ${config.text} ${config.border} ${sizeClass} ${
        isClickable ? 'cursor-pointer hover:brightness-95 transition-all' : ''
      } ${className}`}
    >
      {config.icon}
      <span>{config.label}</span>
      {isClickable && <span className="text-[9px] underline ml-0.5 lowercase font-normal">(source)</span>}
    </span>
  );
}
</file>

<file path="apps/web/src/components/DuringConsultIntelligence.tsx">
import { 
  X, 
  Database, 
  Activity, 
  Pill, 
  FileText, 
  AlertCircle
} from 'lucide-react';
import type { RelevantContext, ClinicalEvidence } from '../types/clinicalBrain';

interface DuringConsultIntelligenceProps {
  contexts: RelevantContext[];
  onDismissContext: (id: string) => void;
  onSelectEvidence: (evidence: ClinicalEvidence) => void;
  isRecording?: boolean;
}

export default function DuringConsultIntelligence({
  contexts,
  onDismissContext,
  onSelectEvidence,
  isRecording = false
}: DuringConsultIntelligenceProps) {
  if (contexts.length === 0) {
    if (!isRecording) return null;
    return (
      <div className="bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs text-slate-500 flex items-center justify-between">
        <div className="flex items-center gap-2">
          <Activity size={14} className="text-brand-500" />
          <span className="font-medium text-slate-600">Clinical Context Stream Active</span>
          <span className="text-slate-400">&bull; Historical context surfaces when relevant concepts are discussed</span>
        </div>
        <span className="text-[10px] uppercase font-bold text-slate-400 bg-white border border-slate-200 px-2 py-0.5 rounded">
          Passive
        </span>
      </div>
    );
  }

  const getCategoryIcon = (category: RelevantContext['category']) => {
    switch (category) {
      case 'medication':
        return <Pill size={13} className="text-emerald-600" />;
      case 'observation':
        return <Activity size={13} className="text-brand-600" />;
