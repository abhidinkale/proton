export default function DoctorDeskEncounter({ patient, onCloseMeeting, onBackToDesk }: DoctorDeskEncounterProps) {
  const [activeTab, setActiveTab] = useState<'note' | 'chart' | 'orders'>('note');

  // Ambient Scribe & Note states
