            <div style="color: #64748b; font-size: 12px;">Date: ${date}</div>
          </div>
        </div>

        <div class="meta-grid">
          <div>
            <div class="meta-label">Patient Name</div>
            <div class="meta-val">${patientName}</div>
            <div style="margin-top: 6px;" class="meta-label">Date of Birth</div>
