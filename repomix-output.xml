  --color-brand-800: #191919;
  --color-brand-900: #151515;
  --color-brand-950: #111111;

  /* ── Typography (Refined Modern Sans-Serif) ── */
  --font-sans: 'Source Sans 3 Variable', sans-serif;
  --font-display: 'Source Sans 3 Variable', sans-serif;
  --font-mono: 'JetBrains Mono', 'SF Mono', ui-monospace, monospace;

  /* ── Clinical Environment (Warm Neutral & White Surfaces) ── */
  --color-surface: #ffffff;
