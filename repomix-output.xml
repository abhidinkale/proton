              <div className="flex items-center justify-between gap-1 mb-1.5">
                <div className="flex items-center gap-1.5 min-w-0">
                  {getCategoryIcon(ctx.category)}
                  <span className="font-bold text-xs text-slate-900 truncate">
                    {ctx.title}
