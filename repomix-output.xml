<file path="apps/web/src/components/MemoryProposalPanel.tsx">
import { useState } from 'react';
import { 
  Check, 
  X, 
  Edit2, 
  FileText,
  Save
} from 'lucide-react';
import type { MemoryProposal } from '../types/clinicalBrain';

interface MemoryProposalPanelProps {
  proposals: MemoryProposal[];
  onApprove: (id: string) => void;
  onReject: (id: string) => void;
  onEdit: (id: string, newContent: string) => void;
  onApproveAll: () => void;
}

export default function MemoryProposalPanel({
  proposals,
  onApprove,
  onReject,
  onEdit,
  onApproveAll
}: MemoryProposalPanelProps) {
  const [editingId, setEditingId] = useState<string | null>(null);
  const [editText, setEditText] = useState('');

  if (proposals.length === 0) return null;

  const handleStartEdit = (p: MemoryProposal) => {
    setEditingId(p.id);
    setEditText(p.editedContent || p.proposedChange);
  };

  const handleSaveEdit = (id: string) => {
    onEdit(id, editText);
    setEditingId(null);
  };

  const approvedCount = proposals.filter(p => p.status === 'APPROVED').length;
  const rejectedCount = proposals.filter(p => p.status === 'REJECTED').length;
  const pendingCount = proposals.filter(p => p.status === 'PROPOSED').length;

  return (
    <div className="bg-white border border-brand-200/90 rounded-2xl shadow-sm overflow-hidden mb-8">
      {/* Header */}
      <div className="bg-gradient-to-r from-brand-50 via-purple-50 to-white px-6 py-4 border-b border-brand-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div className="flex items-center gap-2.5">
          <div className="h-8 w-8 rounded-lg bg-brand-600 text-white flex items-center justify-center shadow-xs">
            <FileText size={18} />
          </div>
          <div>
            <div className="flex items-center gap-2">
              <h3 className="font-bold text-slate-900 text-sm tracking-tight">
                PATIENT MEMORY UPDATE PROPOSALS
              </h3>
              <span className="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-brand-100 text-brand-800 border border-brand-200">
                Physician Gate Required
              </span>
            </div>
            <p className="text-xs text-slate-500 mt-0.5">
              Proton detected updates to the patient's longitudinal story. Doctor reviews and approves each item before FHIR persistence.
            </p>
          </div>
        </div>

        <div className="flex items-center gap-2 shrink-0">
          {pendingCount > 0 && (
            <button
              onClick={onApproveAll}
              className="px-3.5 py-1.5 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold rounded-lg transition-colors flex items-center gap-1.5 shadow-xs cursor-pointer"
            >
              <Check size={14} /> Approve All Proposals ({proposals.length})
            </button>
          )}
        </div>
      </div>

      {/* Proposals List */}
      <div className="p-6 space-y-3">
        <div className="flex items-center justify-between text-xs text-slate-500 pb-1">
          <span>
            {approvedCount} Approved &bull; {rejectedCount} Rejected &bull; {pendingCount} Pending Review
          </span>
          <span className="text-[11px] font-medium text-slate-400">
            Unapproved changes will NEVER mutate FHIR confirmed memory
          </span>
        </div>

        <div className="divide-y divide-slate-100 border border-slate-200 rounded-xl overflow-hidden bg-slate-50/30">
          {proposals.map((prop) => {
            const isApproved = prop.status === 'APPROVED';
            const isRejected = prop.status === 'REJECTED';
            const isEditing = editingId === prop.id;

            const categoryBadge = () => {
              switch (prop.category) {
                case 'NEW':
                  return <span className="text-[10px] font-bold px-2 py-0.5 rounded bg-blue-100 text-blue-800">+ NEW</span>;
                case 'CHANGED':
                  return <span className="text-[10px] font-bold px-2 py-0.5 rounded bg-amber-100 text-amber-900">→ CHANGED</span>;
                case 'RESOLVED':
                  return <span className="text-[10px] font-bold px-2 py-0.5 rounded bg-emerald-100 text-emerald-900">✓ RESOLVED</span>;
                case 'PENDING':
                default:
                  return <span className="text-[10px] font-bold px-2 py-0.5 rounded bg-purple-100 text-purple-900">PENDING</span>;
              }
            };

            return (
              <div
                key={prop.id}
                className={`p-4 flex flex-col md:flex-row md:items-center justify-between gap-3 transition-colors ${
                  isApproved ? 'bg-emerald-50/30' : isRejected ? 'bg-slate-50 opacity-60' : 'bg-white'
                }`}
              >
                <div className="space-y-1 flex-1">
                  <div className="flex items-center gap-2 flex-wrap">
                    {categoryBadge()}
                    <span className="font-bold text-slate-900 text-xs">{prop.title}</span>
                    <span className={`text-[10px] font-semibold px-2 py-0.5 rounded border ${
                      isApproved ? 'bg-emerald-100 text-emerald-800 border-emerald-300' :
                      isRejected ? 'bg-slate-200 text-slate-600 border-slate-300' :
                      prop.status === 'EDITED' ? 'bg-blue-100 text-blue-800 border-blue-300' :
                      'bg-amber-50 text-amber-800 border-amber-200'
                    }`}>
                      {prop.status}
                    </span>
                  </div>

                  {isEditing ? (
                    <div className="flex items-center gap-2 pt-1">
                      <input
                        type="text"
                        value={editText}
                        onChange={(e) => setEditText(e.target.value)}
                        className="flex-1 text-xs border border-brand-300 rounded px-2.5 py-1.5 focus:outline-none focus:ring-1 focus:ring-brand-500 bg-white"
                      />
                      <button
                        onClick={() => handleSaveEdit(prop.id)}
                        className="px-2.5 py-1.5 bg-brand-600 text-white rounded text-xs font-semibold hover:bg-brand-700 flex items-center gap-1 cursor-pointer"
                      >
                        <Save size={13} /> Save
                      </button>
                      <button
                        onClick={() => setEditingId(null)}
                        className="px-2.5 py-1.5 bg-slate-200 text-slate-700 rounded text-xs font-semibold hover:bg-slate-300 cursor-pointer"
                      >
                        Cancel
                      </button>
                    </div>
                  ) : (
                    <p className={`text-xs ${isRejected ? 'line-through text-slate-400' : 'text-slate-800 font-medium'}`}>
                      {prop.editedContent || prop.proposedChange}
                    </p>
                  )}

                  <p className="text-[11px] text-slate-500 italic">
                    Reasoning: {prop.reasoning}
                  </p>
                </div>

                {/* Actions */}
                <div className="flex items-center gap-2 shrink-0 self-end md:self-center">
                  {!isEditing && (
                    <button
                      onClick={() => handleStartEdit(prop)}
                      className="p-1.5 text-slate-400 hover:text-brand-600 hover:bg-slate-100 rounded-lg transition-colors cursor-pointer"
                      title="Edit proposal"
                    >
                      <Edit2 size={14} />
                    </button>
                  )}

                  <button
                    onClick={() => onApprove(prop.id)}
                    className={`px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1 transition-colors cursor-pointer ${
                      isApproved
                        ? 'bg-emerald-600 text-white shadow-xs'
                        : 'bg-slate-100 text-slate-700 hover:bg-emerald-50 hover:text-emerald-700'
                    }`}
                  >
                    <Check size={13} /> {isApproved ? 'Approved' : 'Approve'}
                  </button>

                  <button
                    onClick={() => onReject(prop.id)}
                    className={`px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1 transition-colors cursor-pointer ${
                      isRejected
                        ? 'bg-slate-700 text-white shadow-xs'
                        : 'bg-slate-100 text-slate-700 hover:bg-red-50 hover:text-red-700'
                    }`}
                  >
                    <X size={13} /> {isRejected ? 'Rejected' : 'Reject'}
                  </button>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  );
}
</file>

<file path="apps/web/src/components/OnboardingFlow.tsx">
import { useState, useEffect, useCallback } from 'react';
import { useNavigate } from 'react-router-dom';
import {
  Activity,
  Users,
  FileText,
  Mic,
  ShieldCheck,
  CheckCircle2,
  AlertTriangle,
  ArrowRight,
  ArrowLeft,
  X,
  ChevronRight,
  Check,
  Clock,
  Pill,
  TrendingUp,
  ShieldAlert,
  Stethoscope
} from 'lucide-react';

interface OnboardingFlowProps {
  onComplete: () => void;
  onSkip: () => void;
}

const STORAGE_KEY = 'proton_onboarding_complete';
const TOTAL_STEPS = 6;

export default function OnboardingFlow({ onComplete, onSkip }: OnboardingFlowProps) {
  const [currentStep, setCurrentStep] = useState<number>(1);
  const navigate = useNavigate();

  const handleComplete = useCallback(() => {
    try {
      localStorage.setItem(STORAGE_KEY, 'true');
    } catch (e) {
      console.warn('Unable to persist onboarding completion state', e);
    }
    onComplete();
  }, [onComplete]);

  const handleSkip = useCallback(() => {
    try {
      localStorage.setItem(STORAGE_KEY, 'true');
    } catch (e) {
      console.warn('Unable to persist onboarding completion state', e);
    }
    onSkip();
  }, [onSkip]);

  const handleOpenDemoPatient = useCallback(() => {
    try {
      localStorage.setItem(STORAGE_KEY, 'true');
    } catch (e) {
      console.warn('Unable to persist onboarding completion state', e);
    }
    onComplete();
    navigate('/patients');
  }, [onComplete, navigate]);

  const goToNext = useCallback(() => {
    if (currentStep < TOTAL_STEPS) {
      setCurrentStep(prev => prev + 1);
    } else {
      handleComplete();
    }
  }, [currentStep, handleComplete]);

  const goToPrev = useCallback(() => {
    if (currentStep > 1) {
      setCurrentStep(prev => prev - 1);
    }
  }, [currentStep]);

  // Keyboard navigation: Escape to skip, Arrow keys to navigate
  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        handleSkip();
      } else if (e.key === 'ArrowRight' && currentStep < TOTAL_STEPS) {
        goToNext();
      } else if (e.key === 'ArrowLeft' && currentStep > 1) {
        goToPrev();
      }
    };
    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, [currentStep, goToNext, goToPrev, handleSkip]);

  const isDarkMode = false;

  return (
    <div 
      className={`proton-onboarding fixed inset-0 z-50 flex flex-col overflow-y-auto transition-colors duration-500 ${
        isDarkMode 
          ? 'bg-slate-950 text-slate-100 proton-grid-pattern' 
          : 'bg-slate-50/95 text-slate-900'
      }`}
      role="dialog"
      aria-modal="true"
      aria-label="Proton Onboarding Tour"
    >
      {/* ── TOP HEADER / STEP INDICATOR BAR ── */}
      <header 
        className={`sticky top-0 z-20 px-4 sm:px-8 py-4 transition-colors duration-300 border-b ${
          isDarkMode 
            ? 'bg-slate-950/90 border-slate-800/80' 
            : 'bg-white/90 border-slate-200/80 shadow-xs'
        }`}
      >
        <div className="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3">
          {/* Logo & Clinical Badge */}
          <div className="flex items-center gap-3">
            <div className="h-9 w-9 rounded-lg bg-slate-100 text-slate-900 flex items-center justify-center">
              <Activity size={20} strokeWidth={2.5} />
            </div>
            <div>
              <div className="flex items-center gap-2">
                <span className={`font-bold tracking-tight text-base ${isDarkMode ? 'text-white' : 'text-slate-900'}`}>
                  PROTON
                </span>
                <span className="proton-micro-label px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 border border-slate-200">
                  <span className="hidden sm:inline">Workspace guide</span>
                  <span className="sm:hidden">Guide</span>
                </span>
              </div>
              <p className={`text-[11px] font-medium hidden sm:block ${isDarkMode ? 'text-slate-400' : 'text-slate-500'}`}>
                Physician-led clinical support
              </p>
            </div>
          </div>

          {/* Stepper with connecting lines */}
          <div className="order-last flex w-full flex-col items-center sm:order-none sm:w-auto">
            <span className={`text-[11px] font-semibold uppercase tracking-wider mb-1.5 ${isDarkMode ? 'text-slate-400' : 'text-slate-500'}`}>
              Step {currentStep} of {TOTAL_STEPS}
            </span>
            <div className="flex items-center">
              {Array.from({ length: TOTAL_STEPS }, (_, i) => i + 1).map((s, index) => {
                const isCompleted = s < currentStep;
                const isCurrent = s === currentStep;

                return (
                  <div key={s} className="flex items-center">
                    {/* Step Node */}
                    <button
                      onClick={() => setCurrentStep(s)}
                      aria-label={`Go to step ${s}`}
                      className={`h-7 w-7 rounded-full flex items-center justify-center text-xs font-bold transition-all cursor-pointer ${
                        isCurrent
                          ? 'bg-brand-600 text-white ring-4 ring-brand-500/25 scale-110 shadow-sm'
                          : isCompleted
                            ? 'bg-emerald-600 text-white hover:bg-emerald-700'
                            : isDarkMode
                              ? 'bg-slate-900 border border-slate-700 text-slate-500 hover:text-slate-300'
                              : 'bg-slate-100 border border-slate-300 text-slate-400 hover:text-slate-700'
                      }`}
                    >
                      {isCompleted ? <Check size={13} strokeWidth={3} /> : s}
                    </button>

                    {/* Connecting Line */}
                    {index < TOTAL_STEPS - 1 && (
                      <div
                        className={`h-[2px] w-4 sm:w-8 md:w-12 transition-colors duration-300 ${
                          s < currentStep
                            ? 'bg-emerald-600'
                            : isDarkMode
                              ? 'bg-slate-800'
                              : 'bg-slate-200'
                        }`}
                      />
                    )}
                  </div>
                );
              })}
            </div>
          </div>

          {/* Skip / Close Link */}
          <div className="flex items-center gap-2">
            <button
              onClick={handleSkip}
              className={`inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg transition-colors cursor-pointer ${
                isDarkMode 
                  ? 'text-slate-400 hover:text-white hover:bg-slate-900' 
                  : 'text-slate-500 hover:text-slate-900 hover:bg-slate-100'
              }`}
            >
              <span>Skip tutorial</span>
              <X size={14} />
            </button>
          </div>
        </div>
      </header>

      {/* ── STEP CONTENT CONTAINER ── */}
      <main className="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12 flex items-center">
        <div key={currentStep} className="w-full proton-animate-in">
          {currentStep === 1 && (
            <StepOneWelcome onNext={goToNext} onSkip={handleSkip} />
          )}

          {currentStep === 2 && (
            <StepTwoCommandCenter onNext={goToNext} onPrev={goToPrev} />
          )}

          {currentStep === 3 && (
            <StepThreePatientIntelligence onNext={goToNext} onPrev={goToPrev} />
          )}

          {currentStep === 4 && (
            <StepFourConsultation onNext={goToNext} onPrev={goToPrev} />
          )}

          {currentStep === 5 && (
            <StepFiveVerifyApprove onNext={goToNext} onPrev={goToPrev} />
          )}

          {currentStep === 6 && (
            <StepSixLongitudinalMemory 
              onPrev={goToPrev} 
              onComplete={handleComplete} 
              onOpenDemo={handleOpenDemoPatient} 
            />
          )}
        </div>
      </main>

      {/* ── BOTTOM FOOTER BAR ── */}
      <footer 
        className={`px-4 sm:px-8 py-3.5 border-t text-xs transition-colors duration-300 ${
          isDarkMode 
            ? 'bg-slate-950/80 border-slate-850 text-slate-500' 
            : 'bg-white/80 border-slate-200 text-slate-500'
        }`}
      >
        <div className="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2">
          <div className="flex items-center gap-2">
            <span className="font-semibold">Proton Clinical Platform</span>
            <span>&bull;</span>
            <span>Synthetic Evaluation Environment</span>
            <span>&bull;</span>
            <span className="text-amber-500 font-medium">Physician Approval Gated</span>
