}

:root {
  --space-1: 0.25rem;
  --space-2: 0.5rem;
  --space-3: 0.75rem;
  --space-4: 1rem;
  --space-6: 1.5rem;
  --space-8: 2rem;
  --radius-control: 0.5rem;
  --radius-card: 0.75rem;
  --radius-dialog: 1rem;
}

/* ── Base Styles (Quiet Clinical Workspace) ── */
html, body {
  background-color: #fafaf9;
  color: #18181b;
  font-family: var(--font-sans);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
