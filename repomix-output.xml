            color: #166534;
            display: flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 6px;
          }
          .approval-text {
            color: #15803d;
            font-size: 12px;
            font-style: italic;
          }
          .footer-disclaimer {
            margin-top: 36px;
            padding-top: 14px;
            border-top: 1px solid #e2e8f0;
            font-size: 11px;
            color: #94a3b8;
            line-height: 1.4;
          }
        </style>
      </head>
      <body>
        <div class="header">
