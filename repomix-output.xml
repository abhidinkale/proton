/* Workspace appearance */
.proton-theme-toggle {
  display: inline-flex;
  min-height: 34px;
  align-items: center;
  justify-content: center;
  gap: 7px;
  padding: 0 10px;
  border: 1px solid #e5e5e5;
  border-radius: 8px;
  background: #fff;
  color: #525252;
  font: inherit;
  font-size: 11px;
  font-weight: 550;
  cursor: pointer;
  transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;
}

.proton-theme-toggle:hover {
  border-color: #c8c8c8;
  background: #f7f7f7;
  color: #171717;
}

.proton-card {
  border-radius: 12px;
