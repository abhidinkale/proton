          {/* TAB 3: PRESCRIPTIONS & ORDERS */}
          {activeTab === 'orders' && (
            <div className="flex-1 overflow-y-auto p-6 space-y-6">
              <div className="rounded-2xl border border-[#e4e4e7] bg-white p-5 shadow-xs">
