# =============================================================================
# Proton free-tier deployment environment — EXAMPLE ONLY
# =============================================================================
# Copy to deploy/.env.deploy, then replace every REPLACE_ME value.
#   cp deploy/.env.deploy.example deploy/.env.deploy
#   chmod 600 deploy/.env.deploy
#
# This file is shell-sourced by scripts/*.sh and read by Compose via
# --env-file. Use plain KEY=value lines (no `export`, no spaces around `=`).
# Values are not shell-quoted in the examples because hex secrets and R2 keys
# are safe unquoted; if you paste a value containing spaces, wrap it in quotes.
#
# NEVER COMMIT deploy/.env.deploy. It is covered by the repo-root .env.* rule
# and deploy/.gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Postgres (required)
# -----------------------------------------------------------------------------
# POSTGRES_PASSWORD MUST be URL-safe: use `openssl rand -hex 32` (hex only).
# docker-compose.free.yml interpolates it into DATABASE_URL, so characters like
# `/`, `@`, `:`, or `#` would corrupt the connection string.
POSTGRES_USER=proton
POSTGRES_PASSWORD=REPLACE_ME_openssl_rand_hex_32
POSTGRES_DB=proton_ops

# DATABASE_URL is constructed by docker-compose.free.yml from the three values
# above. Uncomment and set this ONLY if you run the API outside this compose
# file; the host must then be `postgres` (the compose service name).
# DATABASE_URL=postgres://proton:REPLACE_ME@postgres:5432/proton_ops

# -----------------------------------------------------------------------------
# Application secrets (required; production refuses to boot without them)
# -----------------------------------------------------------------------------
# openssl rand -hex 32  -> 64 chars (>= the 32-char minimum)
PROTON_AUTH_SECRET=REPLACE_ME_openssl_rand_hex_32
# openssl rand -hex 32  -> 64 chars (>= the 16-char minimum)
INTERNAL_AGENT_SECRET=REPLACE_ME_openssl_rand_hex_32

# Must be false in production. Kept explicit so nobody "helpfully" flips it.
PROTON_SYNTHETIC_MODE=false
PROTON_ALLOW_DEMO_ACCOUNTS=false
# Enable only after you have tested the MFA challenge end to end.
PROTON_REQUIRE_MFA=false

# -----------------------------------------------------------------------------
# AI provider
# -----------------------------------------------------------------------------
# demo = deterministic, $0, no external calls (recommended for the demo VM)
# real = calls the provider below and may incur quota/cost
PROTON_AI_MODE=demo
# demo | gemini | deepseek | grok
PROTON_AI_PROVIDER=demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
DEEPSEEK_API_KEY=
XAI_API_KEY=

# -----------------------------------------------------------------------------
# FHIR / Medplum (optional for the demo)
# -----------------------------------------------------------------------------
# in_memory is the only mode that needs no FHIR server. Set to `medplum` only
# when both MEDPLUM_BASE_URL and MEDPLUM_TOKEN are real values.
PROTON_FHIR_PERSISTENCE_MODE=in_memory
MEDPLUM_BASE_URL=https://api.medplum.com/
MEDPLUM_CLIENT_ID=
MEDPLUM_TOKEN=

# -----------------------------------------------------------------------------
# Clinic tenancy (required once the first clinic exists)
# -----------------------------------------------------------------------------
# A clinician authenticated through Medplum is placed in this tenant by
# middleware/medplumExchange.js. Unset, it falls back to `org-default` — which
# no provisioned organization ever uses, so the clinician signs in successfully
# and then sees an empty schedule, an empty Care Loop and no patients.
#
# Steps:
#   1. Leave this as `org-default` for the very first boot (there is no org yet).
#   2. Create the clinic:  POST /api/organizations  {name, ownerEmail, ...}
#   3. Put the returned `organization.id` here.
#   4. `docker compose ... up -d api` to restart, then sign in.
PROTON_DEFAULT_TENANT_ID=org-default

# -----------------------------------------------------------------------------
# Web / CORS
# -----------------------------------------------------------------------------
# Comma-separated exact origins. Wildcards are not supported by the API.
# Include the Cloudflare Pages custom domain, e.g. https://app.example.com.
CORS_ALLOWED_ORIGINS=https://app.example.com

# -----------------------------------------------------------------------------
# Cloudflare Tunnel (required)
# -----------------------------------------------------------------------------
# From: cloudflared tunnel token proton-api
# Treat this like a password: anyone with it can run your tunnel.
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_ME_cloudflare_tunnel_token

# -----------------------------------------------------------------------------
# Backups to Cloudflare R2 (required for scripts/backup-to-r2.sh)
# -----------------------------------------------------------------------------
# rclone remote name created by `rclone config` (recommended: r2).
BACKUP_S3_REMOTE=r2
BACKUP_S3_BUCKET=proton-backups
# Everything lives under this prefix in the bucket.
BACKUP_S3_PREFIX=backups

# Retention: 14 daily + 8 weekly + 6 monthly.
BACKUP_RETENTION_DAYS=14
BACKUP_RETENTION_WEEKS=8
BACKUP_RETENTION_MONTHS=6

# Encryption (strongly recommended). Install `age` and put the PUBLIC key here.
# Private key handling: keep it OFF this VM (password manager + printed copy).
# Losing the private key makes every encrypted backup unrecoverable.
BACKUP_AGE_RECIPIENT=
# Only needed by restore-from-r2.sh. Path on the machine running the restore.
BACKUP_AGE_IDENTITY=/root/proton-backup-age.key
# gpg alternative, used only if `age` is unavailable.
BACKUP_GPG_RECIPIENT=

# Where backup-to-r2.sh appends its JSON-lines audit trail.
BACKUP_LOG_FILE=/opt/proton/deploy/backups.log

# Optional non-interactive rclone configuration (instead of `rclone config`).
# If these are set, rclone creates the remote from the environment. Get the
# keys from Cloudflare R2 -> Manage R2 API Tokens.
# RCLONE_CONFIG_R2_TYPE=s3
# RCLONE_CONFIG_R2_PROVIDER=Cloudflare
# RCLONE_CONFIG_R2_ACCESS_KEY_ID=REPLACE_ME
# RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=REPLACE_ME
# RCLONE_CONFIG_R2_ENDPOINT=https://REPLACE_ME_ACCOUNT_ID.r2.cloudflarestorage.com
# RCLONE_CONFIG_R2_REGION=auto
# RCLONE_CONFIG_R2_ACL=private

# -----------------------------------------------------------------------------
# Healthcheck (deploy/healthcheck.sh)
# -----------------------------------------------------------------------------
# Host-local API URL; port 3002 is bound to 127.0.0.1 by the compose file.
PROTON_HEALTH_URL=http://127.0.0.1:3002
# Fail if free disk or RAM falls to/below these percentages.
MIN_FREE_DISK_PCT=10
MIN_FREE_RAM_PCT=10
DISK_PATH=/
# Optional UptimeRobot push monitor. On failure the script appends
# ?status=down&msg=...; on success it pings the URL unchanged.
UPTIMEROBOT_PUSH_URL=

# -----------------------------------------------------------------------------
# Web build (NOT read by Compose — used by the Cloudflare Pages build)
# -----------------------------------------------------------------------------
# Vite inlines these at build time, so they must be exported before `npm run
# build`, not set at runtime. Never put server secrets in VITE_* variables.
VITE_API_URL=https://api.example.com
VITE_MEDPLUM_BASE_URL=https://api.medplum.com/
VITE_SYNTHETIC_MODE=false
