# Proton Environment Template

# AI Configuration
# Modes: demo | real
PROTON_AI_MODE=demo

# Providers: deepseek | gemini | grok | demo
PROTON_AI_PROVIDER=demo

# DeepSeek Configuration (Controlled Physician Beta)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Gemini Configuration
GEMINI_API_KEY=
PROTON_AI_MODEL=gemini-3.8-flash

# Grok Configuration
XAI_API_KEY=
XAI_MODEL=grok-2-vision-1212

# Medplum FHIR Configuration
MEDPLUM_BASE_URL=http://localhost:8103

# ------------------------------------------------------------------------------
# Security posture
# ------------------------------------------------------------------------------
# 32+ random characters. REQUIRED in production; the API refuses to boot without it.
PROTON_AUTH_SECRET=
# 16+ random characters. REQUIRED in production.
INTERNAL_AGENT_SECRET=

# Off automatically when NODE_ENV=production. Set explicitly to false to disable
# the seeded development physician fallback in any environment.
PROTON_SYNTHETIC_MODE=false
PROTON_ALLOW_DEMO_ACCOUNTS=false
PROTON_REQUIRE_MFA=false

# ------------------------------------------------------------------------------
# Web client (build-time; Vite inlines these)
# ------------------------------------------------------------------------------
# Only enable for trusted synthetic evaluation builds.
VITE_SYNTHETIC_MODE=false
VITE_API_URL=http://localhost:3002
VITE_MEDPLUM_BASE_URL=http://localhost:8103/
